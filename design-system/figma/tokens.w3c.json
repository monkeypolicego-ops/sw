{
  "$schema": "https://tr.designtokens.org/format/",
  "Slimming World Design System": {
    "$description": "W3C DTCG-compliant design tokens for Slimming World. Compatible with Style Dictionary 4+ and Figma Variables REST API.",

    "Color": {
      "$description": "Brand palette",
      "Green": {
        "900": { "$value": "#003d22", "$type": "color" },
        "800": { "$value": "#005a32", "$type": "color" },
        "700": { "$value": "#006e3d", "$type": "color" },
        "600": { "$value": "#007a44", "$type": "color" },
        "500": { "$value": "#008a4e", "$type": "color", "$description": "Primary brand green" },
        "400": { "$value": "#33a46e", "$type": "color" },
        "300": { "$value": "#66be93", "$type": "color" },
        "200": { "$value": "#99d8b8", "$type": "color" },
        "100": { "$value": "#ccecdb", "$type": "color" },
        "50":  { "$value": "#e8f7f0", "$type": "color" }
      },
      "Red": {
        "900": { "$value": "#7a0f0f", "$type": "color" },
        "800": { "$value": "#991414", "$type": "color" },
        "700": { "$value": "#b81a1a", "$type": "color" },
        "600": { "$value": "#cc2020", "$type": "color" },
        "500": { "$value": "#e02626", "$type": "color", "$description": "Primary accent / coral red" },
        "400": { "$value": "#e85555", "$type": "color" },
        "300": { "$value": "#f08080", "$type": "color" },
        "200": { "$value": "#f7aaaa", "$type": "color" },
        "100": { "$value": "#fbd4d4", "$type": "color" },
        "50":  { "$value": "#fdf0f0", "$type": "color" }
      },
      "Cream": {
        "500": { "$value": "#d4a96a", "$type": "color" },
        "400": { "$value": "#ddbf8b", "$type": "color" },
        "300": { "$value": "#e6d0ac", "$type": "color" },
        "200": { "$value": "#f0e3ce", "$type": "color" },
        "100": { "$value": "#f7f0e6", "$type": "color" },
        "50":  { "$value": "#fdfaf5", "$type": "color" }
      },
      "Grey": {
        "900": { "$value": "#1a1a1a", "$type": "color" },
        "800": { "$value": "#2e2e2e", "$type": "color" },
        "700": { "$value": "#444444", "$type": "color" },
        "600": { "$value": "#5c5c5c", "$type": "color" },
        "500": { "$value": "#757575", "$type": "color" },
        "400": { "$value": "#9e9e9e", "$type": "color" },
        "300": { "$value": "#bdbdbd", "$type": "color" },
        "200": { "$value": "#e0e0e0", "$type": "color" },
        "100": { "$value": "#f2f2f2", "$type": "color" },
        "50":  { "$value": "#fafafa", "$type": "color" }
      },
      "White": { "$value": "#ffffff", "$type": "color" },
      "Black": { "$value": "#000000", "$type": "color" }
    },

    "Semantic": {
      "$description": "Alias tokens that reference the palette above",
      "Primary":      { "$value": "{Color.Green.500}", "$type": "color" },
      "PrimaryDark":  { "$value": "{Color.Green.700}", "$type": "color" },
      "PrimaryLight": { "$value": "{Color.Green.100}", "$type": "color" },
      "Accent":       { "$value": "{Color.Red.500}",   "$type": "color" },
      "AccentDark":   { "$value": "{Color.Red.700}",   "$type": "color" },
      "AccentLight":  { "$value": "{Color.Red.100}",   "$type": "color" },

      "Background": {
        "Page":      { "$value": "{Color.White}",     "$type": "color" },
        "Subtle":    { "$value": "{Color.Cream.50}",  "$type": "color" },
        "Muted":     { "$value": "{Color.Cream.100}", "$type": "color" },
        "Highlight": { "$value": "{Color.Green.50}",  "$type": "color" }
      },
      "Text": {
        "Primary":   { "$value": "{Color.Grey.900}",  "$type": "color" },
        "Secondary": { "$value": "{Color.Grey.600}",  "$type": "color" },
        "Disabled":  { "$value": "{Color.Grey.400}",  "$type": "color" },
        "Inverse":   { "$value": "{Color.White}",     "$type": "color" },
        "Brand":     { "$value": "{Color.Green.700}", "$type": "color" },
        "Accent":    { "$value": "{Color.Red.600}",   "$type": "color" }
      },
      "Border": {
        "Default": { "$value": "{Color.Grey.200}",  "$type": "color" },
        "Strong":  { "$value": "{Color.Grey.400}",  "$type": "color" },
        "Brand":   { "$value": "{Color.Green.400}", "$type": "color" },
        "Accent":  { "$value": "{Color.Red.300}",   "$type": "color" }
      },
      "State": {
        "Success":   { "$value": "{Color.Green.500}", "$type": "color" },
        "SuccessBg": { "$value": "{Color.Green.50}",  "$type": "color" },
        "Warning":   { "$value": "#f5a623",            "$type": "color" },
        "WarningBg": { "$value": "#fef8ec",            "$type": "color" },
        "Error":     { "$value": "{Color.Red.500}",   "$type": "color" },
        "ErrorBg":   { "$value": "{Color.Red.50}",    "$type": "color" },
        "Info":      { "$value": "#0077b6",            "$type": "color" },
        "InfoBg":    { "$value": "#e8f4fc",            "$type": "color" }
      }
    },

    "Font": {
      "Family": {
        "Heading": { "$value": "Playfair Display", "$type": "fontFamily" },
        "Body":    { "$value": "Nunito Sans",      "$type": "fontFamily" },
        "Mono":    { "$value": "Courier New",      "$type": "fontFamily" }
      },
      "Weight": {
        "Regular":   { "$value": 400, "$type": "fontWeight" },
        "Medium":    { "$value": 500, "$type": "fontWeight" },
        "SemiBold":  { "$value": 600, "$type": "fontWeight" },
        "Bold":      { "$value": 700, "$type": "fontWeight" },
        "ExtraBold": { "$value": 800, "$type": "fontWeight" }
      },
      "Size": {
        "2xs": { "$value": "10px", "$type": "fontSize" },
        "xs":  { "$value": "12px", "$type": "fontSize" },
        "sm":  { "$value": "14px", "$type": "fontSize" },
        "md":  { "$value": "16px", "$type": "fontSize", "$description": "Base" },
        "lg":  { "$value": "18px", "$type": "fontSize" },
        "xl":  { "$value": "20px", "$type": "fontSize" },
        "2xl": { "$value": "24px", "$type": "fontSize" },
        "3xl": { "$value": "30px", "$type": "fontSize" },
        "4xl": { "$value": "36px", "$type": "fontSize" },
        "5xl": { "$value": "48px", "$type": "fontSize" },
        "6xl": { "$value": "60px", "$type": "fontSize" }
      },
      "LineHeight": {
        "Tight":   { "$value": 1.2,  "$type": "lineHeight" },
        "Snug":    { "$value": 1.35, "$type": "lineHeight" },
        "Normal":  { "$value": 1.5,  "$type": "lineHeight" },
        "Relaxed": { "$value": 1.65, "$type": "lineHeight" },
        "Loose":   { "$value": 1.8,  "$type": "lineHeight" }
      },
      "LetterSpacing": {
        "Tight":   { "$value": "-0.025em", "$type": "letterSpacing" },
        "Normal":  { "$value": "0em",      "$type": "letterSpacing" },
        "Wide":    { "$value": "0.025em",  "$type": "letterSpacing" },
        "Wider":   { "$value": "0.05em",   "$type": "letterSpacing" },
        "Widest":  { "$value": "0.1em",    "$type": "letterSpacing" }
      }
    },

    "Spacing": {
      "0":   { "$value": "0px",   "$type": "spacing" },
      "1":   { "$value": "4px",   "$type": "spacing" },
      "2":   { "$value": "8px",   "$type": "spacing" },
      "3":   { "$value": "12px",  "$type": "spacing" },
      "4":   { "$value": "16px",  "$type": "spacing" },
      "5":   { "$value": "20px",  "$type": "spacing" },
      "6":   { "$value": "24px",  "$type": "spacing" },
      "8":   { "$value": "32px",  "$type": "spacing" },
      "10":  { "$value": "40px",  "$type": "spacing" },
      "12":  { "$value": "48px",  "$type": "spacing" },
      "16":  { "$value": "64px",  "$type": "spacing" },
      "20":  { "$value": "80px",  "$type": "spacing" },
      "24":  { "$value": "96px",  "$type": "spacing" },
      "32":  { "$value": "128px", "$type": "spacing" }
    },

    "BorderRadius": {
      "None": { "$value": "0px",    "$type": "dimension" },
      "SM":   { "$value": "4px",    "$type": "dimension" },
      "MD":   { "$value": "8px",    "$type": "dimension" },
      "LG":   { "$value": "12px",   "$type": "dimension" },
      "XL":   { "$value": "16px",   "$type": "dimension" },
      "2XL":  { "$value": "24px",   "$type": "dimension" },
      "3XL":  { "$value": "32px",   "$type": "dimension" },
      "Full": { "$value": "9999px", "$type": "dimension" }
    },

    "Shadow": {
      "XS":    { "$value": [{ "color": "rgba(0,0,0,0.05)", "offsetX": "0px", "offsetY": "1px", "blur": "2px",  "spread": "0px" }], "$type": "shadow" },
      "SM":    { "$value": [{ "color": "rgba(0,0,0,0.10)", "offsetX": "0px", "offsetY": "1px", "blur": "3px",  "spread": "0px" }], "$type": "shadow" },
      "MD":    { "$value": [{ "color": "rgba(0,0,0,0.10)", "offsetX": "0px", "offsetY": "4px", "blur": "6px",  "spread": "-1px" }], "$type": "shadow" },
      "LG":    { "$value": [{ "color": "rgba(0,0,0,0.10)", "offsetX": "0px", "offsetY": "10px","blur": "15px", "spread": "-3px" }], "$type": "shadow" },
      "XL":    { "$value": [{ "color": "rgba(0,0,0,0.10)", "offsetX": "0px", "offsetY": "20px","blur": "25px", "spread": "-5px" }], "$type": "shadow" },
      "Brand": { "$value": [{ "color": "rgba(0,138,78,0.25)", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px" }], "$type": "shadow" },
      "Accent":{ "$value": [{ "color": "rgba(224,38,38,0.20)", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px" }], "$type": "shadow" }
    },

    "Typography": {
      "Heading1": {
        "$value": {
          "fontFamily":    "{Font.Family.Heading}",
          "fontWeight":    "{Font.Weight.Bold}",
          "fontSize":      "{Font.Size.5xl}",
          "lineHeight":    "{Font.LineHeight.Tight}",
          "letterSpacing": "{Font.LetterSpacing.Tight}"
        },
        "$type": "typography"
      },
      "Heading2": {
        "$value": {
          "fontFamily":    "{Font.Family.Heading}",
          "fontWeight":    "{Font.Weight.Bold}",
          "fontSize":      "{Font.Size.4xl}",
          "lineHeight":    "{Font.LineHeight.Tight}",
          "letterSpacing": "{Font.LetterSpacing.Tight}"
        },
        "$type": "typography"
      },
      "Heading3": {
        "$value": {
          "fontFamily":    "{Font.Family.Heading}",
          "fontWeight":    "{Font.Weight.SemiBold}",
          "fontSize":      "{Font.Size.3xl}",
          "lineHeight":    "{Font.LineHeight.Snug}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Heading4": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.SemiBold}",
          "fontSize":      "{Font.Size.2xl}",
          "lineHeight":    "{Font.LineHeight.Snug}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Heading5": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.SemiBold}",
          "fontSize":      "{Font.Size.xl}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Heading6": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.SemiBold}",
          "fontSize":      "{Font.Size.lg}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Body Large": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Regular}",
          "fontSize":      "{Font.Size.lg}",
          "lineHeight":    "{Font.LineHeight.Relaxed}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Body": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Regular}",
          "fontSize":      "{Font.Size.md}",
          "lineHeight":    "{Font.LineHeight.Relaxed}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Body Small": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Regular}",
          "fontSize":      "{Font.Size.sm}",
          "lineHeight":    "{Font.LineHeight.Relaxed}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Label": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.SemiBold}",
          "fontSize":      "{Font.Size.sm}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Caption": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Regular}",
          "fontSize":      "{Font.Size.xs}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Overline": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Bold}",
          "fontSize":      "{Font.Size.xs}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Widest}"
        },
        "$type": "typography",
        "$description": "Uppercase label — apply text-transform: uppercase in Figma"
      },
      "Button LG": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Bold}",
          "fontSize":      "{Font.Size.lg}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Button MD": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Bold}",
          "fontSize":      "{Font.Size.md}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      },
      "Button SM": {
        "$value": {
          "fontFamily":    "{Font.Family.Body}",
          "fontWeight":    "{Font.Weight.Bold}",
          "fontSize":      "{Font.Size.sm}",
          "lineHeight":    "{Font.LineHeight.Normal}",
          "letterSpacing": "{Font.LetterSpacing.Normal}"
        },
        "$type": "typography"
      }
    }
  }
}
